# syntax=docker/dockerfile:1.7
# ==============================================================================
# Production Next.js Standalone Multi-Stage Dockerfile (Node.js 22 Slim)
# - Next.js output: "standalone" bundles only production dependencies into .next/standalone
# - Stage 1 (deps): Dependency caching via BuildKit npm cache mount
# - Stage 2 (builder): Rebuild acceleration via Next.js compiler cache mount (/app/.next/cache)
# - Stage 3 (runner): Minimal unprivileged runtime (nextjs:nodejs UID/GID 10001)
# - Host-agnostic listener: HOSTNAME="0.0.0.0" and PORT=3000 for container orchestrators
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependencies installation
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS deps

WORKDIR /app

# Install dependencies using npm cache mount to speed up subsequent runs
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# ------------------------------------------------------------------------------
# Stage 2: Application compilation & standalone bundle generation
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Disable Next.js anonymous telemetry during image build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Compile Next.js application with persistent cache mount for .next/cache
RUN --mount=type=cache,target=/app/.next/cache \
    npm run build

# ------------------------------------------------------------------------------
# Stage 3: Hardened unprivileged production runtime
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create dedicated unprivileged system group and user (UID/GID 10001)
RUN groupadd -g 10001 nodejs && \
    useradd -u 10001 -g nodejs -s /sbin/nologin -M nextjs && \
    mkdir -p /app/.next/cache && \
    chown -R nextjs:nodejs /app/.next/cache

# Copy static assets and standalone bundle
# Next.js output file tracing automatically bundles required node_modules inside standalone
COPY --chown=nextjs:nodejs --from=builder /app/public ./public
COPY --chown=nextjs:nodejs --from=builder /app/.next/standalone ./
COPY --chown=nextjs:nodejs --from=builder /app/.next/static ./.next/static

# Enforce unprivileged user execution
# hadolint ignore=DL3066
USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
